{
  "name": "@ts-type/package-dts",
  "version": "3.0.10",
  "private": false,
  "description": "A Typescript type definition for NPM package json",
  "keywords": [
    ".d.ts",
    "@types",
    "declaration",
    "definition",
    "dev",
    "develop",
    "development",
    "dts",
    "environment",
    "ide",
    "interface",
    "json",
    "node",
    "package",
    "package.json",
    "playground",
    "runtime",
    "schema",
    "ts",
    "type",
    "type-level",
    "typeing",
    "typelevel",
    "types",
    "typescript",
    "typing",
    "typings"
  ],
  "homepage": "https://github.com/bluelovers/ws-ts-type/tree/master/packages/package-dts#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-ts-type/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-ts-type.git",
    "directory": "packages/package-dts"
  },
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "coverage": "ynpx nyc pnpm run test",
    "lint": "eslint **/*.ts",
    "pretest": "pnpm run build",
    "test": "echo pnpm run ts:check",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "node --run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -u",
    "test:snapshot": "pnpm run test",
    "test:tsd": "ynpx tsd",
    "posttest": "git commit -m \"build(schema): update schema\" ./types ./schema & echo posttest",
    "build": "pnpm run update:schema",
    "preversion": "pnpm run test",
    "prepublishOnly": "echo prepublishOnly",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "ts:check": "tsc --noEmit -p tsconfig.check.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p",
    "update:schema": "tsx ./script/index"
  },
  "dependencies": {
    "@types/semver": "^7.8.0",
    "ts-type": "^3.0.14",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "json-schema": "^0.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "fa1d461d70669aad17f322801a5fde844b2e0c73",
  "sharedDependencies": {
    "eslint-config-bluelovers": "latest"
  }
}
