{
  "extends": "@bluelovers/tsconfig/esm/mapfile.json",
  "compilerOptions": {
    "module": "node16",
    "skipLibCheck": true,
    "strictFunctionTypes": true,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "lib",
    "src"
  ],
  "exclude": [
    "node_modules",
    "test"
  ]
}
