{
  "name": "typed-http-headers",
  "version": "1.0.28",
  "description": "標準 HTTP 請求與回應標頭的 TypeScript 類型定義 | TypeScript type definitions for standard HTTP request and response headers",
  "homepage": "https://github.com/bluelovers/ws-ts-type/tree/master/packages/ts-http-header#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-ts-type/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-ts-type.git",
    "directory": "packages/ts-http-header"
  },
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "coverage": "ynpx nyc pnpm run test",
    "lint": "ynpx eslint **/*.ts",
    "test": "echo jest --passWithNoTests",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "node --run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -u",
    "test:node": "node --run test:node:bin -- **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:node:bin": "tsx --test --test-update-snapshots --",
    "test:node:bin:coverage": "node --run test:node:bin -- --experimental-test-coverage --",
    "test:snapshot": "pnpm run test -u",
    "test:tsc": "tsc --noEmit & echo Type checking completed (main)",
    "test:tsc:all": "node --run test:tsc && node --run test:tsc:sub",
    "test:tsc:sub": "cd test && tsc --noEmit & echo Type checking completed (test)",
    "test:tsd": "ynpx tsd",
    "preversion": "pnpm run test",
    "prepublishOnly": "pnpm run ncu && pnpm run sort-package-json",
    "postpublish_": "git commit -m \"publish new version\" .",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "ts-type": "^3.0.23"
  },
  "gitHead": "87053c85cbdf7965a9d46ad66afb9f1cf976c60c"
}
